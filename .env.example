DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/avengers_bank
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=14
DB_ECHO=false
# 시스템 작업 API(대금 출금) 키, 32자 이상. 비우면 그 API는 꺼짐
SYSTEM_API_KEY=
# ClearingHub: 수신에는 두 키, 발신에는 등록 후 받은 은행 코드와 API 키도 필요
CLEARING_HUB_URL=https://clearing-hub.ai-agent-develop.cloud
CLEARING_PRIVATE_KEY=
CLEARING_HUB_PUBLIC_KEY=
CLEARING_BANK_CODE=
CLEARING_API_KEY=
# RAG·Agent: Google AI Studio 키. 비우면 RAG API·AI 상담은 503. 배포에서는 호스팅의 비밀 값으로 넣는다
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Gemini 생각 수준 low|medium|high (비우면 low, ADR 0016). 3.8 Flash는 minimal을 지원하지 않음
GEMINI_THINKING=
# 서버 전체 AI 호출 하루 한도 (채팅 1번 = 3). 비우면 100 (ADR 0026)
AI_DAILY_LIMIT=
# 주변 매장 검색용 카카오 REST API 키. 비우면 예시 매장으로 시연할 수 있음
KAKAO_LOCAL_API_KEY=
# Agent 실행 추적 (cloud.langfuse.com 무료 프로젝트 키). 비우면 꺼짐
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 서버(compose.prod.yaml)에서만: HTTPS 주소 <이름>.duckdns.org와 IP 갱신 토큰 (ADR 0025)
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
