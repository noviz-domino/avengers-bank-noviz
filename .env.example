DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/avengers_bank
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=14
DB_ECHO=false
# 시스템 작업 API(대금 출금) 키, 32자 이상. 비우면 그 API는 꺼짐
SYSTEM_API_KEY=
# RAG·Agent: Google AI Studio 키. 비우면 RAG API·AI 상담은 503. 배포에서는 호스팅의 비밀 값으로 넣는다
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Gemini 생각 수준 low|medium|high (비우면 low, ADR 0016). 3.8 Flash는 minimal을 지원하지 않음
GEMINI_THINKING=
# Agent 실행 추적 (cloud.langfuse.com 무료 프로젝트 키). 비우면 꺼짐
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
